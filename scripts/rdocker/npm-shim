#!/bin/bash
# rdocker npm shim (~/.local/bin/npm): `npm run <heavy test script>` -> `rrun npm run ...` so the test
# runner and its DB run together on the Mac mini, whoever starts it (an agent, a script, bash -c ...).
# The script names mirror rr_route_patterns (rd_common) for npm. Everything else, and RRUN=0 / already-under-rrun / on the mini, execs the real npm untouched.
# rrun's own laptop fallback sets RRUN=0, so a down mini cannot loop back here.
self="${BASH_SOURCE[0]}"
real=""
IFS=: read -r -a dirs <<< "${PATH:-}"
for d in "${dirs[@]}"; do
  [ -n "$d" ] && [ -x "$d/npm" ] && [ ! "$d/npm" -ef "$self" ] && { real="$d/npm"; break; }
done
[ -n "$real" ] || { echo "rdocker npm shim: no real npm on PATH" >&2; exit 127; }
# Only a TOP-LEVEL npm (started from a shell) is routed. npm spawned by another program - a node runner
# or git hook firing 150 `npm run --silent check:x` (2026-10-15) - or inside another npm script stays
# here: the parent job is the unit that gets routed, and one round trip per tiny step costs more than
# it saves.
parent=$(ps -o comm= -p "$PPID" 2>/dev/null); parent=${parent##*/}; parent=${parent#-}
case "$parent" in zsh|bash|sh|dash|fish|rrun) top=1 ;; *) top=0 ;; esac
[ -n "${npm_lifecycle_event:-}" ] && top=0
if [ "$top" = 1 ] && [ "${RRUN:-}" != "0" ] && [ -z "${RRUN_REMOTE:-}" ] && command -v rrun >/dev/null 2>&1; then
  # first two positional args (flags and the values of --prefix / -w / --workspace / -C skipped)
  pos=(); skip=0; extra=0; dd=0
  for a in "$@"; do
    if [ "$dd" = 1 ]; then case "$a" in -*) ;; *) extra=1 ;; esac; continue; fi
    [ "$a" = "--" ] && { dd=1; continue; }
    if [ "$skip" = 1 ]; then skip=0; continue; fi
    case "$a" in
      --prefix|-w|--workspace|-C) skip=1 ;;
      -*) ;;
      *) pos+=("$a") ;;
    esac
  done
  want=0
  for a in "$@"; do      # the hook's skip markers: these runs need the laptop
    case "$a" in *real-od/*|*doctor-drive*|--approve=browser) pos=(); break ;; esac
  done
  # a WHOLE test suite (`npm test`, `npm run test`, no file args) is heavy; one or two files stay local
  case "${pos[0]:-}" in
    test|t|tst) [ "${#pos[@]}" -eq 1 ] && [ "$extra" = 0 ] && want=1 ;;
    run|run-script|rum|urn)
      [ "${pos[1]:-}" = test ] && [ "${#pos[@]}" -eq 2 ] && [ "$extra" = 0 ] && want=1
      case "${pos[1]:-}" in test:db|test:db:rls|release:rehearse:migrations|check:db-all|check:server-test-typecheck) want=1 ;; esac
      # by category (mirrors rr_route_patterns): check / lint / typecheck / verify and test:* scripts,
      # never browser / e2e / watch ones (those need the laptop)
      s1="${pos[1]:-}"
      if [[ "$s1" =~ ^(check|lint|typecheck|type-check|verify)(:.*)?$ || "$s1" =~ ^test:.+ ]] \
         && ! [[ "$s1" =~ (e2e|playwright|browser|watch|:ui$|:ui:) ]]; then want=1; fi ;;
  esac
  [ "$want" = 1 ] && exec rrun npm "$@"      # mini resolves its own npm; a laptop fallback re-enters here with RRUN=0
fi
exec "$real" "$@"
