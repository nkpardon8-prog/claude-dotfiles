<?xml version="1.0" encoding="UTF-8"?>
<!-- rd-worker-mac on a Mac worker: root LaunchDaemon, starts at boot and is restarted if it ever exits.
     Holds the AC-only keep-awake while sharing is on and re-kicks com.rdocker.sshd when Tailscale returns.
     Installed by install-worker-mac.sh. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.rdocker.worker</string>
  <key>ProgramArguments</key><array><string>/bin/sh</string><string>/usr/local/libexec/rd-worker-mac</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>Nice</key><integer>10</integer>
  <key>StandardOutPath</key><string>/var/log/rd-worker-mac.log</string>
  <key>StandardErrorPath</key><string>/var/log/rd-worker-mac.log</string>
</dict>
</plist>
