telemetry/
session-env/
*.log
.DS_Store

# Scratch/working dirs — never committed. tmp/ holds god-review findings,
# pre-compact briefs, ready-plans, etc. that often contain fixture strings
# tripping the secret-scan and shouldn't be auto-pushed anyway.
tmp/

# Secrets — never commit
.env
.env.*
!.env.example
credentials.md
credentials.local.md
# R3 D5: glob covers CLAUDE.local.md (alias), CLAUDE.local.<sid8>.md (SID-tagged primary),
# CLAUDE.local.md.prev (snapshot), and future .tmp variants.
# Pattern: CLAUDE.local*.md* — wildcard after .local covers SID8 segment; trailing * covers
# .prev suffix on the alias. Matches: CLAUDE.local.md, CLAUDE.local.18d1779a.md,
# CLAUDE.local.md.prev. The original **/CLAUDE.local.md* did NOT match SID-tagged files.
**/CLAUDE.local*.md*

# Common secret-bearing files (defense in depth)
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
id_ecdsa
id_ecdsa.*
.ssh/
.aws/credentials
.aws/config
.gcp/
*.credentials.json
credentials.json
*service-account*.json
*-key.json
.netrc
# Added 2026-08-03 after a god-report finding verified BOTH layers missing these.
# This repo runs `git add -A` and auto-pushes to a PUBLIC remote, so an unignored
# secret-bearing file is one `direnv allow` / `npm login` / `docker login` from exposure.
# The asymmetry that makes gitignore load-bearing here: .envrc holds an arbitrary
# `export DB_PASSWORD=<opaque>`, which NO scanner can pattern-match - so for that file this
# is the only control that can work. (An npm_ lane was added to secret-scan.sh as the
# second layer for .npmrc, whose token has a fixed prefix.)
# NOTE `*.credentials.json` above does NOT cover a bare `credentials.json` - the wildcard
# reads broader than it is, which is exactly how that one slipped through; hence the
# explicit entry added above it.
.envrc
.npmrc
.dockercfg
.docker/config.json
.npmrc.local
.pypirc

# Editor / OS swap files that may contain partial buffer contents
*.swp
*.swo
*~
.#*

# Mac mini CRD skill — built Go binaries (not committed)
skills/macmini/server/dist/
skills/macmini/client/dist/

# Codex bridge — generated locally from commands/ and skills/
codex/generated/
__pycache__/
