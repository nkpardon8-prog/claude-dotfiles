{
  "_template_note": "Copy this file to ~/.claude/settings.json on each machine. ~/.claude/settings.json is per-machine and not tracked in this dotfiles repo. Re-run on every fresh setup.",
  "_security_note": "This template's permission allow-list is INTENTIONALLY STRICTER than the author's live settings: mcp__supabase__apply_migration / execute_sql (no silent DB mutations), Bash(node -e :*) / Bash(python3 -c :*) (no arbitrary -e/-c code execution), and Bash(curl :*) (no unattended egress) are deliberately absent here even where a live machine allows them. It still auto-allows pip/npm install AND sets skipDangerousModePermissionPrompt + skipAutoPermissionPrompt, which only makes sense on a personal dev machine the operator fully trusts. Review before copying to any shared machine or CI runner.",
  "permissions": {
    "allow": [
      "Bash(npm install)",
      "Bash(npm install:*)",
      "Bash(npm run build)",
      "Bash(npm run build:*)",
      "Bash(npm run dev)",
      "Bash(npm run dev:*)",
      "Bash(npm run lint)",
      "Bash(npm run lint:*)",
      "Bash(npm run test)",
      "Bash(npm run test:*)",
      "Bash(npm run typecheck)",
      "Bash(npm run typecheck:*)",
      "Bash(npm ls --depth=0)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx vite --port :*)",
      "Bash(python -m py_compile :*)",
      "Bash(python3 -m py_compile :*)",
      "Bash(python -m pytest :*)",
      "Bash(python3 -m pytest :*)",
      "Bash(pip install :*)",
      "Bash(pip install postgrest)",
      "Bash(pip install pytest-asyncio)",
      "Bash(open :*)",
      "Bash(lsof :*)",
      "Bash(fgrep :*)",
      "mcp__supabase__list_branches",
      "mcp__supabase__list_tables",
      "mcp__supabase__search_docs",
      "mcp__supabase__get_logs",
      "Read(//tmp/**)",
      "Read(//private/tmp/**)",
      "Bash(bash /Users/omidzahrai/.claude-dotfiles/scripts/hooks/mission-write.sh:*)"
    ],
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd ~/.claude-dotfiles && git pull --ff-only 2>/dev/null; bash ~/.claude-dotfiles/scripts/install-git-hooks.sh >/dev/null 2>&1 || { [ -f ~/.claude/.dotfiles-sync-paused ] || printf 'kind: other\nreason: SessionStart could not refresh the git hooks - local secret gate may be stale\n' > ~/.claude/.dotfiles-sync-paused; }; C=~/.config/claude/credentials.md; N=0; while [ -L \"$C\" ] && [ $N -lt 10 ]; do L=$(readlink \"$C\"); case \"$L\" in /*) C=$L ;; *) C=$(dirname \"$C\")/$L ;; esac; N=$((N+1)); done; if [ -L \"$C\" ]; then echo 'WARNING: could NOT scan ~/.config/claude/credentials.md - symlink chain deeper than 10 hops. This is a SCAN FAILURE, not a detected secret. Do not rotate anything; investigate the path.' >&2; elif [ -f \"$C\" ]; then bash \"$HOME/.claude-dotfiles/scripts/secret-scan.sh\" \"$C\" 2>/dev/null; case $? in 0) ;; 2) echo 'WARNING: possible secret value detected in ~/.config/claude/credentials.md - should be op:// references only. Rotate the leaked secret at the provider.' >&2 ;; *) echo 'WARNING: could NOT scan ~/.config/claude/credentials.md - this is a SCAN FAILURE, not a detected secret. Do not rotate anything; investigate the scanner.' >&2 ;; esac; fi; true",
            "timeout": 10,
            "statusMessage": "Syncing dotfiles...",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude-dotfiles/scripts/progress/on-session-start-cleanup.sh",
            "async": true
          }
        ]
      },
      {
        "matcher": "compact|resume|startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude-dotfiles/scripts/hooks/post-compact-primer.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude-dotfiles/scripts/hooks/stale-handoff-guard.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude-dotfiles/scripts/hooks/prod-ledger.py inject"
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude-dotfiles/scripts/hooks/line-reassert-identity.sh",
            "timeout": 10,
            "async": true
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude-dotfiles/scripts/hooks/line-replies-notice.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude-dotfiles/scripts/hooks/ctx-gate-on-prompt-submit.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/.claude-dotfiles/scripts/hooks/dotfiles-sync-pause-notice.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/.claude-dotfiles/scripts/hooks/mission-pending-reask.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude-dotfiles/scripts/dotfiles-sync.sh",
            "async": true
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude-dotfiles/scripts/hooks/prod-ledger.py record"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude-dotfiles/scripts/hooks/auto-compact-after-pre-compact.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude-dotfiles/scripts/hooks/mission-liveness.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude-dotfiles/scripts/hooks/ctx-gate-precompact-safety.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude-dotfiles/scripts/hooks/prod-coordination-gate.py"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude-dotfiles/scripts/hooks/no-detach-gate.py"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude-dotfiles/scripts/hooks/shared-path-overwrite-guard.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "effortLevel": "xhigh",
  "skipDangerousModePermissionPrompt": true,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "_mission_write_note": "The mission-write.sh allow entry MUST stay an absolute literal path (permission allow patterns do not expand $HOME or ~). On a fresh machine, rewrite /Users/omidzahrai to the installing user's home: sed -i '' 's|/Users/omidzahrai|/Users/<you>|' ~/.claude/settings.json",
  "skillListingBudgetFraction": 0.05
}
